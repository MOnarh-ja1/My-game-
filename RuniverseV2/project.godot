; RUNIVERSE — MgameIO: PC 3D Endless Runner with 50 heroes
config_version=5

[application]
config/name="RUNIVERSE"
config/description="RUNIVERSE: 50 героев, 5 миров, анимации и способности — MgameIO"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1672
window/size/viewport_height=941
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.11, 0.19, 0.24, 1)

[physics]
common/physics_ticks_per_second=60
