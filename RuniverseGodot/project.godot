; RUNIVERSE — original 3D endless runner | Godot 4.7.2
config_version=5

[application]
config/name="RUNIVERSE — Миры на бегу"
config/description="3D бег, пять миров, магазин, монеты, анимированный герой."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/use_physical_light_units=false
environment/defaults/default_clear_color=Color(0.5, 0.76, 0.95, 1)

[physics]
common/physics_ticks_per_second=60
